{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clean",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "rm -rf build"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build App",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/briefcase",
      "args": [
        "build",
        "macOS"
      ],
      "problemMatcher": []
    },
    {
      "label": "Release: Create GitHub Release",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/release.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run App",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/briefcase",
      "args": [
        "run",
        "macOS"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run Dashboard Script",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "scripts/generate_dashboard.py"
      ],
      "problemMatcher": []
    },

    {
      "label": "Build Only",
      "dependsOn": [
        "Clean",
        "Build App"
      ],
      "dependsOrder": "sequence",
      "group": "build"
    },

    {
      "label": "Build and Run App",
      "dependsOn": [
        "Clean",
        "Build App",
        "Run App"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },

    {
      "label": "Build + Run + Dashboard",
      "dependsOn": [
        "Clean",
        "Build App",
        "Run App",
        "Run Dashboard Script"
      ],
      "dependsOrder": "sequence"
    }
  ]
}
